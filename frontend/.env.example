# Copy to .env.local. NEXT_PUBLIC_ values are inlined into the browser bundle,
# so never put secrets here.

# Where the backend API is running
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public URL of this frontend. Used for absolute links in social previews
# (og:image). Only needed when deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
