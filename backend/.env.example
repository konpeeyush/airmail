# Copy to .env and fill in. Never commit .env.

# Defaults to production when unset; `pnpm dev` sets development itself.
NODE_ENV=development
PORT=4000

# Origin of the frontend allowed to call this API. Requests from any other
# site's pages are refused.
CORS_ORIGIN=http://localhost:3000

# Set when the API runs behind a reverse proxy, e.g. 1 on Render, Railway or Fly,
# so rate limits apply per visitor rather than to the proxy.
TRUST_PROXY=

# SMTP
# Leave SMTP_HOST empty in development to use an auto-created Ethereal test
# inbox (mail is captured, not delivered; the API returns a preview link).
# Required in production.
#
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=you@gmail.com,
#        SMTP_PASS=<16-char App Password, not your Google password>
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS); defaults from the port if unset
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=
# Sender shown to recipients, e.g. "Email Composer <you@gmail.com>". Defaults to SMTP_USER.
MAIL_FROM=

# Attachments (field name: "attachments")
MAX_FILE_SIZE_MB=5
MAX_FILES=5
# Keep under ~18 MB: base64 adds ~37% and most providers cap emails at 25 MB
MAX_TOTAL_SIZE_MB=15

# Rate limits for POST /api/emails, per IP: emails, and recipients in total
RATE_LIMIT_MAX=20
RATE_LIMIT_MAX_RECIPIENTS=100
RATE_LIMIT_WINDOW_MINUTES=15
